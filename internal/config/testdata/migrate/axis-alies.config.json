{
  "version": 1,
  "name": "axis-alies",
  "prefix": "aa",
  "lanes_dir": "../axis-alies-wt",
  "paths": {
    "reviews": "docs/reviews"
  },
  "commands": {
    "lane_setup": "bun install --frozen-lockfile && cp bun.lock node_modules/.lane-lock",
    "check": {
      "cmd": "bun run check:engine",
      "timeout": 600,
      "heavy": true
    },
    "check_fast": "bun run check:engine",
    "lane_ready": "cmp -s bun.lock node_modules/.lane-lock",
    "check_milestone": {
      "cmd": "bun scripts/nightlyStep.ts check_milestone -- bun run check:engine:nightly -- bun scripts/weeklyParked.ts -- bun run soak-maps --timeout 600",
      "timeout": 14400,
      "heavy": true
    },
    "after_merge": {
      "cmd": "bun install --frozen-lockfile",
      "when": [
        "bun.lock"
      ],
      "timeout": 300
    }
  },
  "lane_links": [
    "reference",
    "public/assets"
  ],
  "protected_files": [
    "src/engine/types.ts"
  ],
  "lanes": 4,
  "roles": {
    "integrator": "sonnet:medium",
    "reviewer": "terra:xhigh",
    "lead": "opus:high",
    "deep_dive": "opus:high",
    "advisor": "fable:high",
    "triage": "opus:medium"
  },
  "merge": {
    "summary_regex": "[0-9]+ pass|[0-9]+ fail",
    "fail_grep": "error TS|×|\\(fail\\)|Expected|Received",
    "nightly_at": "02:00"
  },
  "guards": {
    "allow_push": [
      "lead"
    ]
  },
  "difficulty": {
    "hard": [
      "opus:medium"
    ],
    "medium": [
      "deepseek",
      "sonnet:medium"
    ],
    "simple": [
      "deepseek"
    ]
  },
  "handoff_tokens": 500000,
  "kinds": {
    "claude": {
      "prompt_extra": "Checks: AGENTS.md 'Test load' (light lanes). Quote summary lines and failures only. task_done report: add a Mutation line (what you broke, which test failed)."
    },
    "codex": {
      "args": [
        "-c",
        "sandbox_workspace_write.network_access=true"
      ]
    },
    "opencode": {
      "command": "obor-kind-opencode",
      "prompt_extra": "You run in opencode, not sandboxed and without herd hooks: no git commands, no installs, edit only the files your spec lists, stay in this directory. Read AGENTS.md first. Quote summary lines and failures only. task_done report: add a Mutation line (what you broke, which test failed)."
    }
  },
  "models": {
    "deepseek": {
      "kind": "opencode",
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "setup": {
    "confirmed": true
  }
}
