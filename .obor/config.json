{
  "version": 1,
  "name": "obor-kit",
  "prefix": "ob",
  "lanes_dir": "../obor-kit-wt",
  "done_file_sections": [
    "Summary",
    "Self-check",
    "Skipped",
    "Open questions"
  ],
  "paths": {
    "reviews": "docs/reviews"
  },
  "commands": {
    "after_merge": {
      "cmd": "make build OUT=${OBOR_ROOT:-.}/dist/obor",
      "timeout": 300,
      "when": [
        "cmd/**",
        "internal/**",
        "go.mod",
        "go.sum",
        "Makefile"
      ]
    },
    "compile": {
      "cmd": "make -s check-compile",
      "timeout": 600
    },
    "check": {
      "cmd": "make -s check",
      "timeout": 1200,
      "heavy": true
    },
    "check_affected": {
      "cmd": "make -s check-affected",
      "timeout": 1200,
      "heavy": true
    },
    "check_readers": {
      "cmd": "make -s check-readers",
      "timeout": 1200,
      "heavy": true
    },
    "retest": {
      "cmd": "make -s check-retest",
      "timeout": 600
    },
    "check_web": {
      "cmd": "make -s check-web",
      "timeout": 1200,
      "heavy": true
    },
    "check_release": {
      "cmd": "make -s check-release",
      "timeout": 1200,
      "heavy": true
    },
    "guard": {
      "cmd": "set -e; n=0; while IFS= read -r f; do case \"$f\" in *.sh|bin/obor|githooks/*) if [ -f \"$f\" ]; then /bin/bash -n \"$f\"; n=$((n + 1)); fi ;; esac; done < \"$OBOR_CHANGED_FILES\"; /bin/bash bin/obor config validate; jq -e . .claude-plugin/plugin.json .claude-plugin/marketplace.json hooks/hooks.json > /dev/null; echo \"guard OK: bash -n on $n changed script(s), obor config validate, plugin JSON\"",
      "timeout": 120
    },
    "check_milestone": {
      "cmd": "go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./...",
      "timeout": 600
    },
    "conformance": {
      "cmd": "make -s conformance TIER=static",
      "timeout": 300
    },
    "trim_go_cache": {
      "cmd": "make -s trim-go-cache",
      "timeout": 600
    }
  },
  "difficulty": {
    "medium": [
      "deepseek",
      "sonnet:medium",
      "opus:medium"
    ],
    "simple": [
      "deepseek",
      "sonnet:medium",
      "opus:medium"
    ]
  },
  "protected_files": [
    "docs/design.md"
  ],
  "lanes": 4,
  "roles": {
    "reviewer": "terra:xhigh",
    "lead": "opus:high",
    "deep_dive": "opus:high",
    "integrator": "opus:medium",
    "researcher": "sonnet:medium"
  },
  "merge": {
    "trailer": "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>",
    "summary_regex": "[0-9]+ pass|[0-9]+ fail",
    "guard": "guard",
    "nightly_at": "02:00",
    "nightly_commands": [
      "conformance",
      "trim_go_cache"
    ],
    "classes": [
      {
        "name": "web",
        "paths": [
          "web/src/**",
          "internal/web/dist/**"
        ],
        "checks": [
          "check_web"
        ]
      },
      {
        "name": "go",
        "paths": [
          "cmd/**",
          "internal/**"
        ],
        "checks": [
          "check_affected"
        ]
      },
      {
        "name": "release",
        "paths": [
          "Makefile",
          "scripts/**",
          "install.sh",
          "RELEASING.md",
          ".claude-plugin/marketplace.json",
          "tests/release/**"
        ],
        "checks": [
          "check_release"
        ]
      },
      {
        "name": "readers",
        "paths": [
          "skills/**",
          "templates/**",
          "hooks/**",
          "bin/go-commands",
          ".claude-plugin/**"
        ],
        "checks": [
          "check_readers"
        ]
      }
    ],
    "neutral": [
      "docs/**",
      "ADOPTION-*.md",
      "AGENTS.md",
      "BACKLOG.md",
      "BRIEF.md",
      "CLAUDE.md",
      "QUESTIONS.md",
      "STATUS.md",
      ".gitignore"
    ],
    "affected_full": [
      "Makefile",
      "internal/testkit/**",
      "internal/herdrtest/**",
      "internal/herdr/herdrtest/**"
    ],
    "fail_grep": "^--- FAIL|^FAIL\\s"
  },
  "task_id_pattern": "(T|R)-[0-9]+[a-z]?",
  "guards": {
    "allow_push": [
      "lead"
    ],
    "deny_commands": [
      {
        "match": "^(?:go(?: (?:-C [^ ]+|--?[^ ]+))* test|[^ ]*\\.test)(?: [^ ]+)* (?:--?(?:test\\.)?count[= ](?:[2-9]|[1-9][0-9]+)(?: |$)|--?(?:test\\.)?race(?: |$|=f(?: |$)|=fa(?: |$)|=fal(?: |$)|=fals(?: |$)|=false[^ ][^ ]*(?: |$)|=f[^a ][^ ]*(?: |$)|=fa[^l ][^ ]*(?: |$)|=fal[^s ][^ ]*(?: |$)|=fals[^e ][^ ]*(?: |$)|=0[^ ][^ ]*(?: |$)|=[^f0 ][^ ]*(?: |$)|=(?: |$)))",
        "alone": true,
        "message": "a load run of tests (`-count` > 1, `-race`) is denied — one plain `go test <pkgs>` run; the gate and nightly run the rest"
      },
      {
        "match": "^(?:go(?: (?:-C [^ ]+|--?[^ ]+))* test|[^ ]*\\.test)(?: |$)",
        "message": "two or more test commands at once (a background &, xargs -P, parallel) are a load run — one plain `go test <pkgs>` run; the gate and nightly run the rest"
      }
    ]
  },
  "slots": {
    "max": 4,
    "cpus": 4
  },
  "setup": {
    "confirmed": true
  },
  "handoff_tokens": 500000,
  "kinds": {
    "opencode": {
      "prompt_extra": "You run in opencode, not sandboxed: obor's opencode plugin, not hooks, enforces the role text's denials. Quote summary lines and failures only."
    }
  }
}
