#!/bin/sh
# release <x.y.z> [--dry-run]: the lead's one command for a release (RELEASING.md). In the main checkout, on the branch
# the loop merges to (`staging`; T-1035: no checkout of main, no separate worktree), with a clean tree,
# docs/UPGRADE-v<x.y>.md holding a v<version> heading and docs/releases/v<version>.md holding the release notes, it runs
# eight steps. Each step first looks for its done evidence (present: the step is skipped, so a re-run resumes where the
# last run stopped), and a step that fails runs its undo, so the next run starts from a clean tree (T-643):
#   review guard  done: no code merged since the branch's first-parent "RV-<n> closed" commit, or UNREVIEWED="<why>" (the
#                 owner's call; it goes into the tag message)         fail: refuse, nothing changed
#   bump          done: VERSION and the plugin version = <version> at HEAD, set by an "obor v<version>: …" commit on
#                 the branch's first-parent line                      fail: both paths' index and tree back to HEAD
#   check         the full `make check`, run only when the bump is not committed   fail: undo the bump
#   upgrade check `make upgrade-check` (T-772), run only while the tag is not made: the previous release (the catalog's
#                 newest below <version>) upgraded to this build; SKIP_UPGRADE_CHECK="<why>" skips it (the owner's call,
#                 like UNREVIEWED; it goes into the tag message)   fail: refuse, nothing tagged (the bump stays committed)
#   release check `make check-release` (T-902), run only while the tag is not made: tests/release (the Makefile,
#                 scripts/ and install.sh against fixture repos), not part of `make check` (behind //go:build release,
#                 T-1001)   fail: refuse, nothing tagged (the bump stays committed)
#   tag           done: a local tag v<version> whose commit changes only the catalog and marketplace name on top of its
#                 source parent, which differs from HEAD in docs and bin/checksums.txt only (scripts/release-lib.sh)
#                 make: a scratch worktree detached at HEAD under this repo's git dir, marketplace name obor-kit,
#                 `make release` (the eight binaries: obor and the OpenCode kind per platform, T-1046; and
#                 bin/checksums.txt), commit, tag     fail: remove the scratch
#                 worktree; an existing tag is never touched
#   copy-back     done: the branch's bin/checksums.txt has the tag's lines for the release and this checkout's dist
#                 files match them
#                 make: all eight files checked against the tag's catalog first, then copied and the catalog committed
#                 fail: bin/checksums.txt's index and tree back to HEAD
#   main          done: refs/heads/main is the release's "checksums: v<version>" commit or past it
#                 make: fast-forward refs/heads/main to that commit by git update-ref (the
#                 main checkout keeps its own branch checked out: main moves by release, never by a checkout)
#                 fail: main has commits the release lacks (a release never rewinds main)
# The check step reruns a failed go test package once (T-717): when `make check` fails only in go test, the failed
# packages run again in one `go test`; all pass → the release goes on with a FLAKY line per failed test, recorded in
# .obor/state/flakes.jsonl (obor flakes); any fails again → refused, naming the tests. A failure outside go test (build,
# vet, gofmt, deadcode) refuses at once. The whole run (not --dry-run) is also written to
# .obor/state/logs/release-<version>.log (appended on a re-run), and every FAIL line names that log.
# The scratch worktree is removed once the copy-back is done. A tag is never moved (a changed release is a new patch
# version). --dry-run prints the steps and changes nothing. POSIX sh, like scripts/publish.
set -eu

usage() { echo "usage: release <x.y.z> [--dry-run]" >&2; exit 2; }

v=
dry=0
for arg in "$@"; do
  case $arg in
    --dry-run) dry=1 ;;
    -*) usage ;;
    *) [ -z "$v" ] || usage; v=$arg ;;
  esac
done
[ -n "$v" ] && printf '%s\n' "$v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || usage

tag="v$v"
vre=$(printf '%s' "$v" | sed 's/\./\\./g')
guide="docs/UPGRADE-v${v%.*}.md"
tmpdir=${TMPDIR:-/tmp}

# log: this run's own full log (set below once the run starts; a --dry-run has none).
log=
fail() { echo "FAIL $*${log:+ (full log: $log)}" >&2; exit 1; }
say() { echo "release: $*"; }

# shellcheck source=scripts/release-lib.sh
. "$(dirname "$0")/release-lib.sh"

# plain_make: a nested make starts from a plain make environment. make runs a recipe with its command-line variables
# (V=…, DRY=…) and its own MAKEFLAGS, MFLAGS and MAKELEVEL in the environment, and a nested make reads them back: under
# `make release V=x` the check would run with V=x, and the tests it runs would take their own `make release`'s V= path
# (T-641). UNREVIEWED is the owner's override for this release only: the check's own release tests must not see it
# (T-643); this shell keeps it for the tag message. SKIP_UPGRADE_CHECK likewise (T-772).
plain_make() {
  env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL -u V -u DRY -u UNREVIEWED -u SKIP_UPGRADE_CHECK make "$@"
}

# run_check: the full `make check` (T-717). Its output goes to the terminal and to a scratch file this function reads; a
# red check that is only go test packages is rerun once (one `go test -tags integration <pkgs>`, no -count; the tag runs
# the integration tests again, as the check did, T-1014): all pass → FLAKY lines and flake
# records and the release goes on; else the release is refused. Anything outside go test refuses at once.
run_check() {
  chk=$(mktemp "$tmpdir/obor-check.XXXXXX")
  chkst=$(mktemp "$tmpdir/obor-check-status.XXXXXX")
  { crc=0; plain_make check 2>&1 || crc=$?; echo "$crc" > "$chkst"; } | tee "$chk"
  crc=$(cat "$chkst"); rm -f "$chkst"
  if [ "$crc" = 0 ]; then rm -f "$chk"; return 0; fi
  undone="nothing is committed (VERSION and the plugin version are back as they were)"
  if grep -Eq '^FAIL (make build|gofmt|go vet|deadcode)' "$chk"; then
    step=$(grep -E '^FAIL (make build|gofmt|go vet|deadcode)' "$chk" | head -n 1)
    rm -f "$chk"
    fail "make check failed ($step), not in go test, so no rerun: $undone"
  fi
  failed=$(failed_tests < "$chk")
  if [ -z "$failed" ] || grep -Eq '^FAIL[[:space:]].*\[(build|setup) failed\]' "$chk"; then
    rm -f "$chk"
    fail "make check failed outside the go test results (no failed test package to rerun): $undone"
  fi
  pkgs=$(printf '%s\n' "$failed" | awk '{ print $1 }' | sort -u | tr '\n' ' ')
  say "make check failed in go test only; rerunning once: $pkgs"
  rerun=$(mktemp "$tmpdir/obor-rerun.XXXXXX")
  rrc=0
  # shellcheck disable=SC2086
  { env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL -u V -u DRY -u UNREVIEWED -u SKIP_UPGRADE_CHECK "${GO:-go}" test -tags integration ${CHECK_CPUS:+-p "$CHECK_CPUS"} $pkgs 2>&1 \
    || echo "go test rerun exit $?" > "$rerun.rc"; } | tee "$rerun"
  [ ! -f "$rerun.rc" ] || rrc=1
  rm -f "$rerun.rc"
  if [ "$rrc" != 0 ]; then
    again=$(failed_tests < "$rerun")
    rm -f "$chk" "$rerun"
    [ -n "$again" ] || again=$failed
    fail "make check failed and the failed packages failed again on rerun: $(printf '%s\n' "$again" | awk '{ print $1 " " $2 }' | tr '\n' ';'): $undone"
  fi
  rm -f "$chk" "$rerun"
  printf '%s\n' "$failed" | while read -r pkg test; do
    echo "FLAKY: $pkg $test (failed, passed on rerun)"
    record_flake "$pkg" "$test"
  done
}

# failed_tests: from go test output on stdin, one "<pkg> <test>" line per failed top-level test, in order (<test> is
# "(package)" for a package that failed without a test line: a panic, a timeout). A "--- FAIL: <name>" line belongs to the
# next "FAIL<TAB><pkg>" line.
failed_tests() {
  awk '
    /^--- FAIL: / { pend[++n] = $3; next }
    $1 == "FAIL" && NF >= 2 {
      if (n == 0) print $2, "(package)"
      for (i = 1; i <= n; i++) print $2, pend[i]
      n = 0
    }'
}

# record_flake <pkg> <test>: one line in obor's flake log (internal/checks/flakes.go), as the checks write it: the test
# name (the package for a package without a test line), check "check", task "release", the sha, retried and passed.
record_flake() {
  name=$2
  [ "$name" != "(package)" ] || name=$1
  mkdir -p .obor/state || return 0
  printf '{"time":%s,"test":"%s","check":"check","task":"release","sha":"%s","load":null,"retried":true,"passed_on_retry":true}\n' \
    "$(date +%s)" "$name" "$(git rev-parse HEAD 2> /dev/null || true)" >> .obor/state/flakes.jsonl ||
    echo "warning: flake log: cannot write .obor/state/flakes.jsonl"
}

# undo: the running step's undo, run when the script exits non-zero; a step sets it before its first change and clears
# it once its done evidence holds.
undo=
tmp=
on_exit() {
  st=$?
  [ -z "$tmp" ] || rm -f "$tmp"
  if [ "$st" != 0 ] && [ -n "$undo" ]; then $undo; fi
}
trap on_exit EXIT

# restore <path>…: the paths' index and working tree back to HEAD (a staged change is undone too, T-643).
restore() {
  git checkout -q HEAD -- "$@" 2> /dev/null || true
}
undo_bump() { restore VERSION .claude-plugin/plugin.json; }
undo_catalog() { restore bin/checksums.txt; }
undo_scratch() { remove_scratch || true; }

# scratch_listed: git's worktree list has the scratch path for this repo.
scratch_listed() {
  git worktree list --porcelain | awk -v p="$scratch" '
    /^worktree / { if (substr($0, 10) == p) found = 1 }
    END { exit !found }'
}

# remove_scratch: the scratch worktree gone (from git's worktree list and the disk). git only removes a worktree it
# lists for this repo, and this script only ever runs that on a path it made (RV-71 #1): never rm -rf.
remove_scratch() {
  [ -e "$scratch" ] || { git worktree prune > /dev/null 2>&1 || true; return 0; }
  git worktree remove --force "$scratch" > /dev/null 2>&1 || return 1
  git worktree prune > /dev/null 2>&1 || true
  [ ! -e "$scratch" ]
}

# not_ours: the refusal for a scratch path that exists but is not this repo's worktree: someone else's directory is
# not ours to delete.
not_ours() {
  fail "$scratch exists and is not this repo's worktree: it is not ours to remove, clear it by hand and re-run"
}

# plugin_version <rev>: the "version" of .claude-plugin/plugin.json at rev.
plugin_version() {
  git show "$1:.claude-plugin/plugin.json" 2> /dev/null |
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
}

# marketplace_name <rev>: the marketplace "name" in .claude-plugin/marketplace.json at rev.
marketplace_name() {
  git show "$1:.claude-plugin/marketplace.json" 2> /dev/null | tr -d '\n' |
    sed -n 's/^[^"]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

# remote_tag: the sha origin holds for v<version> (empty when it has none, or when origin is unreachable).
remote_tag() {
  out=$(git ls-remote origin "refs/tags/$tag" 2> /dev/null) || out=
  printf '%s\n' "$out" | awk -v r="refs/tags/$tag" '$2 == r { print $1; exit }'
}

# never_moves: what to do about a tag whose release cannot be finished as it is.
never_moves() {
  if [ -n "$(remote_tag)" ]; then
    echo "$tag is pushed and a pushed tag never moves: release a new patch version"
  else
    echo "delete the local tag (git tag -d $tag) and re-run, or release a new patch version"
  fi
}

# asset_lines <catalog text>: its lines for this version's files (release-lib.sh's version_lines).
asset_lines() {
  printf '%s\n' "$1" | version_lines "$v"
}

# head_versions_are_v: VERSION and the plugin version at HEAD are both <version>.
head_versions_are_v() {
  [ "$(git show HEAD:VERSION 2> /dev/null | tr -d '[:space:]')" = "$v" ] && [ "$(plugin_version HEAD)" = "$v" ]
}

# bump_done: VERSION and the plugin version are <version> at HEAD and an "obor v<version>: …" commit on the branch's
# first-parent line set them.
bump_done() {
  head_versions_are_v || return 1
  git log --first-parent --format=%s HEAD | grep -q "^obor v$vre: "
}

# check_tag: the existing local tag is this release's, or the release stops (the tag is never touched). The tag's notes
# are checked too (T-683, the same check publish runs): notes committed on the branch after the tag cannot repair the
# tag, and ship would refuse them later.
check_tag() {
  tagver=$(git show "$tag:VERSION" 2> /dev/null | tr -d '[:space:]') || tagver=
  tagplug=$(plugin_version "$tag")
  tagmarket=$(marketplace_name "$tag")
  if [ "$tagver" != "$v" ] || [ "$tagplug" != "$v" ] || [ "$tagmarket" != obor-kit ]; then
    fail "$tag's contents are wrong (VERSION '$tagver', plugin '$tagplug', marketplace '$tagmarket'): $(never_moves)"
  fi
  problem=$(tag_market_problem)
  [ -z "$problem" ] || fail ".claude-plugin/marketplace.json $problem: $(never_moves)"
  problem=$(tag_notes_problem "$(tag_notes)")
  [ -z "$problem" ] || fail "$problem: $(never_moves)"
  require_fresh_tag
}

# dist_source <f>: where the tag's bytes of f are: the scratch worktree's copy when present, else this checkout's.
dist_source() {
  if [ -f "$scratch/$1" ]; then echo "$scratch/$1"; else echo "$1"; fi
}

# check_dist: each of the release's files (dist_source) is there and matches the tag's catalog; nothing is written.
check_dist() {
  for a in $(release_assets "$v"); do
    f="dist/$a"
    src=$(dist_source "$f")
    [ -f "$src" ] ||
      fail "$f is gone (in neither dist/ nor $scratch): a re-run cannot recreate identical bytes; $(never_moves)"
    want=$(printf '%s\n' "$tagcat" | awk -v f="$f" '$2 == f { print $1; exit }')
    got=$(shasum -a 256 "$src" | awk '{ print $1 }')
    [ "$got" = "$want" ] || fail "$src is sha256 $got, not the $tag catalog's $want: $(never_moves)"
  done
}

# copyback_done: the branch's catalog at HEAD has the tag's lines for the release and this checkout's files match them.
copyback_done() {
  [ "$(asset_lines "$(git show HEAD:bin/checksums.txt 2> /dev/null || true)")" = "$tagv" ] || return 1
  for a in $(release_assets "$v"); do
    f="dist/$a"
    [ -f "$f" ] || return 1
    want=$(printf '%s\n' "$tagcat" | awk -v f="$f" '$2 == f { print $1; exit }')
    [ "$(shasum -a 256 "$f" | awk '{ print $1 }')" = "$want" ] || return 1
  done
}

[ -f Makefile ] && [ -f VERSION ] && [ -f .claude-plugin/plugin.json ] ||
  fail "not at a kit checkout's root: run make release V=$v there"

# The whole run goes to the terminal and to .obor/state/logs/release-<version>.log (T-717): the script runs itself again
# with stdout and stderr in one pipe to tee, and passes its exit status on (a plain pipe would lose it). A re-run
# appends, so an earlier failed run's log stays; a release that succeeds removes the log (T-1098: its FAIL lines, the
# reason to keep one, are a failed run's). OBOR_RELEASE_LOGGED marks the inner run.
if [ "$dry" = 0 ]; then
  log=".obor/state/logs/release-$v.log"
  if [ -z "${OBOR_RELEASE_LOGGED:-}" ]; then
    mkdir -p .obor/state/logs || fail "cannot create .obor/state/logs"
    stfile=$(mktemp "$tmpdir/obor-release-status.XXXXXX")
    {
      rc=0
      printf '== release %s %s ==\n' "$v" "$(date '+%Y-%m-%d %H:%M:%S')"
      OBOR_RELEASE_LOGGED=1 sh "$0" "$@" 2>&1 || rc=$?
      echo "$rc" > "$stfile"
    } | tee -a "$log"
    rc=$(cat "$stfile"); rm -f "$stfile"
    exit "${rc:-1}"
  fi
fi

# The branch the release commits land on (T-1035): the main checkout keeps it checked out, and the release fast-forwards
# main to what it commits. A detached HEAD has no line to fast-forward, so it is refused before anything changes.
branch=$(git symbolic-ref --quiet --short HEAD 2> /dev/null) || branch=
[ -n "$branch" ] || fail "on a detached HEAD, not a branch: make release commits the release on the branch it runs on"

# The scratch worktree lives in this repo's own git dir, so two checkouts releasing the same version never share a path
# (RV-71 #1). git prints the common dir relative to the cwd in a plain checkout; pwd -P gives the physical path, the way
# git worktree list prints the worktrees it holds.
common=$(git rev-parse --git-common-dir)
common=$(cd "$common" && pwd -P)
scratch="$common/obor-release-$v"

cur=$(tr -d '[:space:]' < VERSION)
if [ "$cur" != "$v" ]; then
  version_lt "$cur" "$v" || fail "VERSION is $cur: V=$v must be greater (a released version is never rewritten; a change is a new patch version)"
fi

[ -f "$guide" ] || fail "no $guide: write the release guide (with a v$v heading) and commit it on $branch first"
grep -Eq "^#+[[:space:]]*v$vre([^0-9.]|\$)" "$guide" ||
  fail "$guide has no v$v heading: the guide names that version before the release"

# The GitHub release's notes come from docs/releases/v<version>.md at the tag (T-682): the lead writes it with the guide.
notes="docs/releases/v$v.md"
[ -f "$notes" ] ||
  fail "no $notes: write the release notes (a summary line, then - **Name:** bullets) and commit them on $branch first"
grep -q '[^[:space:]]' "$notes" || fail "$notes is empty: it is the GitHub release's notes"

dirty=$(git status --porcelain)
[ -z "$dirty" ] || fail "the working tree is dirty: commit or stash first (a release starts from a clean tree)"

# --- review guard (T-642, T-822). Code merged since the last review that no cycle covered: the first-parent merges on
# the branch in the next review's scope, whose files are not all docs, as the task ids their subjects name. Only a
# subject on the branch's own line counts: never a body line (a merge message carries a whole spec, which may quote a
# close line), never a commit a side branch brought in. A close commit since T-822 carries its cycle's Covered tasks and
# the sha its review started at in the body: the range starts at that sha and the tasks it covered are left out, so a
# task merged while the review's verify ran stays unreviewed until a cycle covers it. An older close commit has no
# Covered line: the range is the close commit itself, as before. No close commit: nothing has been reviewed, so every
# merge counts.
close=$(git log --first-parent --format='%H %s' HEAD | grep -E -m1 '^[0-9a-f]+ RV-[0-9]+ closed' | cut -d' ' -f1)
since="the first commit (no RV closed yet)"
range=HEAD
covered=
if [ -n "$close" ]; then
  since=$(git log -1 --format=%s "$close" | sed -n 's/^\(RV-[0-9][0-9]*\) closed.*/\1/p')
  [ -n "$since" ] || since=$(git rev-parse --short "$close")
  body=$(git log -1 --format=%b "$close")
  covered=$(printf '%s\n' "$body" | sed -n 's/^Covered:[[:space:]]*//p' | tr ',' ' ')
  start=$(printf '%s\n' "$body" | sed -n 's/^Start:[[:space:]]*//p')
  range="${start:-$close}..HEAD"
fi
unreviewed=
for sha in $(git log --first-parent --merges --reverse --format=%H "$range"); do
  code=
  for f in $(git diff --name-only "$sha^1" "$sha"); do
    case $f in
      docs/* | *.md) ;;
      *) code=1; break ;;
    esac
  done
  [ -n "$code" ] || continue
  id=$(git log -1 --format=%s "$sha" | sed -n 's/^Merge \(T-[0-9][0-9]*[a-z]*\):.*/\1/p')
  [ -n "$id" ] || id=$(git rev-parse --short "$sha")
  if [ -n "$covered" ]; then
    case " $covered " in
      *" $id "*) continue ;;
    esac
  fi
  unreviewed="${unreviewed:+$unreviewed, }$id"
done
if [ -n "$unreviewed" ]; then
  if [ -n "${UNREVIEWED:-}" ]; then
    say "unreviewed since $since: $unreviewed (UNREVIEWED: ${UNREVIEWED})"
  else
    fail "unreviewed since $since: $unreviewed (run obor review, close it, then release; or UNREVIEWED=\"<why>\" make release V=$v)"
  fi
fi

# --- bump and check
if bump_done; then
  say "VERSION and the plugin version at HEAD are $v: commit skipped"
elif head_versions_are_v; then
  fail "VERSION and the plugin version at HEAD are already $v but no 'obor $tag: …' commit on $branch set them: put them back to the released version, commit, and re-run"
elif [ "$dry" = 1 ]; then
  say "would: set VERSION and .claude-plugin/plugin.json to $v"
  say "would: make check (the full gate; a failure stops the release, nothing committed)"
  say "would: git commit -m 'obor v$v: VERSION, plugin version' on $branch"
else
  undo=undo_bump
  printf '%s\n' "$v" > VERSION
  tmp=$(mktemp "$tmpdir/obor-plugin.XXXXXX")
  sed 's/"version"[[:space:]]*:[[:space:]]*"[^"]*"/"version": "'"$v"'"/' .claude-plugin/plugin.json > "$tmp" &&
    mv "$tmp" .claude-plugin/plugin.json || fail "cannot set the plugin version in .claude-plugin/plugin.json"
  tmp=
  say "VERSION and the plugin version set to $v; running make check"
  run_check
  git add VERSION .claude-plugin/plugin.json
  git commit -q -m "obor v$v: VERSION, plugin version" ||
    fail "cannot commit the version bump on $branch: VERSION and the plugin version are back at HEAD's (index and tree)"
  bump_done || fail "the version commit does not set VERSION and the plugin version to $v"
  undo=
  say "committed on $branch: obor v$v: VERSION, plugin version"
fi

# --- upgrade check (T-772): before the tag, `make upgrade-check` installs this build over a project the previous
# release made (tests/upgrade); a red check tags nothing, and the re-run (the bump committed) starts here again. An
# existing tag is past it. SKIP_UPGRADE_CHECK="<why>" is the owner's call only, like UNREVIEWED.
if git rev-parse -q --verify "refs/tags/$tag" > /dev/null 2>&1; then
  :
elif [ -n "${SKIP_UPGRADE_CHECK:-}" ]; then
  say "upgrade check skipped (SKIP_UPGRADE_CHECK: ${SKIP_UPGRADE_CHECK})"
elif [ "$dry" = 1 ]; then
  say "would: make upgrade-check (the previous release upgraded to this build; a failure stops the release before the tag)"
else
  say "running make upgrade-check (the previous release upgraded to this build)"
  plain_make upgrade-check ||
    fail "make upgrade-check failed (its step and output above): nothing is tagged; fix it and re-run, or SKIP_UPGRADE_CHECK=\"<why>\" make release V=$v (the owner's call only)"
fi

# --- release tooling check (T-902): before the tag, `make check-release` runs tests/release (the Makefile's check,
# release and publish targets, scripts/release, scripts/ship, scripts/publish and install.sh). The full `make check`
# above runs the same package (go test ./...); naming it here keeps the release depending on it even when the check
# step is skipped (the bump already committed), and a red one tags nothing. An existing tag is past it.
if git rev-parse -q --verify "refs/tags/$tag" > /dev/null 2>&1; then
  :
elif [ "$dry" = 1 ]; then
  say "would: make check-release (the kit's release tooling tests: the Makefile, scripts/ and install.sh; a failure stops the release before the tag)"
else
  say "running make check-release (the kit's release tooling tests: the Makefile, scripts/ and install.sh)"
  plain_make check-release ||
    fail "make check-release failed (above): nothing is tagged; fix it and re-run"
fi

# --- tag
if git rev-parse -q --verify "refs/tags/$tag" > /dev/null 2>&1; then
  check_tag
  say "$tag exists: build and tag skipped"
  planned=0
elif [ "$dry" = 1 ]; then
  say "would: git worktree add --detach $scratch HEAD"
  say "would: set the marketplace name obor-kit there, make release, commit, git tag -a $tag"
  say "would: copy the $(asset_count) dist/<binary>-$v-<os>-<arch> files from $tag to this checkout's dist/"
  say "would: git commit -m 'checksums: $tag' on $branch"
  say "would: remove the worktree $scratch"
  planned=1
else
  undo=undo_scratch
  sha=$(git rev-parse HEAD)
  if [ -e "$scratch" ]; then
    scratch_listed || not_ours
    remove_scratch || fail "cannot remove the scratch worktree $scratch"
  fi

  git worktree add -q --detach "$scratch" "$sha" || fail "cannot add the scratch worktree $scratch"
  market="$scratch/.claude-plugin/marketplace.json"
  tmp=$(mktemp "$tmpdir/obor-marketplace.XXXXXX")
  # Only the top-level name flips (T-645: v0.17.2's sed renamed the plugin entry too, and obor@obor-kit broke).
  market_flip < "$market" > "$tmp" ||
    fail "$market has no single \"name\": \"obor-kit-dev\" to set to obor-kit: nothing is tagged"
  mv "$tmp" "$market" || fail "cannot set the marketplace name in $market"
  tmp=
  problem=$(market_problem "$(cat "$market")" "$(git show "$sha:.claude-plugin/marketplace.json" 2> /dev/null)" \
    "$(jq -r '.name | strings' "$scratch/.claude-plugin/plugin.json" 2> /dev/null)" "$scratch")
  [ -z "$problem" ] || fail ".claude-plugin/marketplace.json $problem: nothing is tagged"
  ( cd "$scratch" && plain_make release V= ) || fail "make release failed in $scratch: nothing is tagged"
  # The tag's message carries the owner's UNREVIEWED reason (T-642): the merges the tag ships past the last review.
  tagmsg="obor $tag"
  [ -z "$unreviewed" ] || tagmsg="$tagmsg
Unreviewed: $unreviewed — ${UNREVIEWED}"
  [ -z "${SKIP_UPGRADE_CHECK:-}" ] || tagmsg="$tagmsg
Upgrade check skipped: ${SKIP_UPGRADE_CHECK}"
  ( cd "$scratch" && git add bin/checksums.txt .claude-plugin/marketplace.json &&
    git commit -q -m "obor v$v: marketplace name, checksums" &&
    git tag -a "$tag" -m "$tagmsg" ) || fail "cannot commit and tag the release in $scratch: nothing is tagged"
  # From here the scratch worktree holds the tag's bytes: it stays until the copy-back is done.
  undo=
  check_tag
  say "tagged $tag in $scratch"
  planned=0
fi

# --- copy-back
if [ "$planned" = 0 ]; then
  tagcat=$(git show "$tag:bin/checksums.txt" 2> /dev/null) || fail "no bin/checksums.txt at $tag: the tag is not a finished release"
  tagv=$(asset_lines "$tagcat")
  [ "$(printf '%s\n' "$tagv" | grep -c . || true)" = "$(asset_count)" ] ||
    fail "bin/checksums.txt at $tag lacks lines for $v's $(asset_count) files: the tag is not a finished release"
  # All the files are checked before anything is written: a failure leaves the branch as it was.
  check_dist

  if copyback_done; then
    say "bin/checksums.txt at HEAD has $tag's lines: copy-back commit skipped"
  elif [ "$dry" = 1 ]; then
    say "would: copy the $(asset_count) dist/<binary>-$v-<os>-<arch> files from $tag to this checkout's dist/"
    say "would: git commit -m 'checksums: $tag' on $branch"
  else
    mkdir -p dist
    for a in $(release_assets "$v"); do
      f="dist/$a"
      [ ! -f "$scratch/$f" ] || cp "$scratch/$f" "$f" || fail "cannot copy $scratch/$f to this checkout"
    done
    headv=$(asset_lines "$(git show HEAD:bin/checksums.txt 2> /dev/null || true)")
    if [ "$headv" = "$tagv" ]; then
      say "bin/checksums.txt at HEAD has $tag's lines: copied the files, copy-back commit skipped"
    else
      undo=undo_catalog
      printf '%s\n' "$tagcat" > bin/checksums.txt
      git add bin/checksums.txt
      git commit -q -m "checksums: $tag" ||
        fail "cannot commit bin/checksums.txt on $branch: it is back at HEAD's (index and tree)"
      say "committed on $branch: checksums: $tag"
    fi
    copyback_done || fail "the branch's bin/checksums.txt or this checkout's dist files do not match $tag's catalog after the copy-back"
    undo=
  fi
fi

if [ -e "$scratch" ]; then
  if [ "$dry" = 1 ]; then
    say "would: remove the worktree $scratch"
  else
    scratch_listed || not_ours
    remove_scratch || fail "cannot remove the scratch worktree $scratch"
    say "removed the worktree $scratch"
  fi
fi

# --- main (T-1035): the release moves main to the commit it made, never by a checkout. The main checkout keeps its own
# branch checked out (staging) and refs/heads/main moves by update-ref. The commit is the
# newest "checksums: v<version>" on the branch's first-parent line (HEAD itself, when the release ran on main).
if [ "$dry" = 1 ]; then
  say "would: move refs/heads/main to the release's 'checksums: $tag' commit (update-ref, no checkout)"
else
  rel=$(git log --first-parent --format='%H %s' HEAD |
    awk -v s="checksums: $tag" '{ h = $1; sub(/^[^ ]* /, "") } $0 == s { print h; exit }')
  [ -n "$rel" ] || fail "no 'checksums: $tag' commit on $branch's first-parent line: the copy-back step makes it"
  relshort=$(git rev-parse --short "$rel")
  at=$(git rev-parse -q --verify refs/heads/main 2> /dev/null) || at=
  [ -n "$at" ] || fail "no refs/heads/main: a release moves main, and this repo has none"
  atshort=$(git rev-parse --short "$at")
  if git merge-base --is-ancestor "$rel" "$at" 2> /dev/null; then
    say "refs/heads/main has $relshort (checksums: $tag): main move skipped"
  elif git merge-base --is-ancestor "$at" "$rel" 2> /dev/null; then
    git update-ref -m "obor release $tag" refs/heads/main "$rel" "$at" ||
      fail "cannot fast-forward refs/heads/main to $relshort"
    say "fast-forwarded refs/heads/main $atshort..$relshort (checksums: $tag)"
  else
    fail "refs/heads/main ($atshort) has commits the release ($relshort) lacks: a release never rewinds main"
  fi
fi

# A release that got here succeeded: its log went with the FAIL lines it existed to name (T-1098). A refused release
# exits at fail above, before this, so its log stays; a --dry-run has none. A removal that fails is no failure.
if [ "$dry" = 0 ]; then
  rm -f "$log" || true
fi

echo "next (owner): make ship"
