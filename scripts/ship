#!/bin/sh
# ship <x.y.z>: the owner's one command after `make release V=<x.y.z>` (RELEASING.md), in the main checkout. It runs on
# whatever branch that checkout has (staging when the loop merges there, T-1035): release already fast-forwarded
# refs/heads/main to the release commit, so no checkout of main is needed and this script never switches or resets the
# checkout's branch or working tree. Before anything leaves this machine the tag must be this release's (scripts/publish
# --check: its contents and the four dist files' bytes) and not predate code in the release (scripts/release-lib.sh).
# The release is the tag plus its `checksums: v<version>` commit on main (the newest with that subject on main's
# first-parent line, T-661): ship pushes main up to that commit, never main's tip, so merges after `make release` wait
# for the next release. Then three steps, each skipped when its done evidence holds and proven by it after it runs
# (T-643):
#   push     done: origin has tag v<version> (the same object) and origin's main contains the checksums commit
#            run: git push origin <checksums commit>:refs/heads/main and/or the tag, whichever origin lacks
#            (OBOR_ALLOW_PUSH=1)                                  fail: stop
#   publish  done: the GitHub release is not a draft and has the four assets
#            run: scripts/publish (no release), or scripts/publish --upload of the missing assets only (its byte
#            checks first)                                       fail: stop with the repair command
#   install  done: `obor version` is v<version>     run: install.sh     fail: stop
# A pushed tag never moves. The last line is the one follow-up: `obor serve restart` in the projects whose serve this
# machine knows (obor projects, else launchd's labels; the generic line when it knows none), then the leads are told what
# changed (one `obor send` per other project, T-903). POSIX sh.
set -eu

usage() { echo "usage: ship <x.y.z>" >&2; exit 2; }
[ "$#" -le 1 ] || usage
v=${1:-}
if [ -z "$v" ]; then v=$(tr -d '[:space:]' < VERSION); fi
printf '%s\n' "$v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || usage

tag="v$v"
platforms="darwin-arm64 darwin-amd64 linux-arm64 linux-amd64"

fail() { echo "FAIL $*" >&2; exit 1; }
say() { echo "ship: $*"; }

# shellcheck source=scripts/release-lib.sh
. "$(dirname "$0")/release-lib.sh"

[ -f Makefile ] && [ -f VERSION ] && [ -f install.sh ] ||
  fail "not at a kit checkout's root: run make ship there"

git rev-parse -q --verify "refs/tags/$tag" > /dev/null 2>&1 || fail "no tag $tag: run make release V=$v first"
[ -z "$(git status --porcelain)" ] || fail "the working tree is dirty: commit first (make ship pushes, it does not commit)"
[ "$(tr -d '[:space:]' < VERSION)" = "$v" ] || fail "VERSION is $(cat VERSION), not $v: make ship ships the released version"

# The release on main: the copy-back commit scripts/release makes ("checksums: v<version>"), the newest on main's
# first-parent line, with the release's catalog. Main past it (later merges) is the next release's.
rel=$(git log --first-parent --format='%H %s' refs/heads/main |
  awk -v s="checksums: $tag" '{ h = $1; sub(/^[^ ]* /, "") } $0 == s { print h; exit }')
[ -n "$rel" ] ||
  fail "no 'checksums: $tag' commit on main's first-parent history: run make release V=$v (it commits the catalog on main)"
relshort=$(git rev-parse --short "$rel")
tagcat=$(git show "$tag:bin/checksums.txt" 2> /dev/null) || fail "no bin/checksums.txt at $tag: run make release V=$v first"
tagv=$(printf '%s\n' "$tagcat" | grep -F "dist/obor-$v-" || true)
[ "$(printf '%s\n' "$tagv" | grep -c . || true)" = 4 ] || fail "bin/checksums.txt at $tag has no four lines for $v"
havev=$(git show "$rel:bin/checksums.txt" 2> /dev/null | grep -F "dist/obor-$v-" || true)
[ "$havev" = "$tagv" ] ||
  fail "bin/checksums.txt at $relshort (checksums: $tag) is not $tag's catalog: make release V=$v commits it"
# The tag's own checks (scripts/publish's: contents and the four files' bytes) run before it leaves this machine.
sh scripts/publish "$v" --check || fail "$tag is not a finished release (above): a pushed tag never moves"
require_fresh_tag "$rel"

# --- push
ltag=$(git rev-parse "refs/tags/$tag")
lmain=$rel
# read_remote: origin's main and tag shas into rmain and rtag (empty when origin lacks one or is unreachable).
read_remote() {
  remote=$(git ls-remote origin refs/heads/main "refs/tags/$tag" 2> /dev/null) || remote=
  rmain=$(printf '%s\n' "$remote" | awk '$2 == "refs/heads/main" { print $1; exit }')
  rtag=$(printf '%s\n' "$remote" | awk -v r="refs/tags/$tag" '$2 == r { print $1; exit }')
}
# main_landed: origin's main is the checksums commit or contains it (fetch-free: an origin main this clone has not seen
# does not count).
main_landed() {
  [ "$rmain" = "$lmain" ] && return 0
  [ -n "$rmain" ] && git merge-base --is-ancestor "$lmain" "$rmain" 2> /dev/null
}
upto="main up to $relshort (checksums: $tag)"
read_remote
if [ "$rtag" = "$ltag" ] && main_landed; then
  say "origin has $upto and $tag: push skipped"
else
  [ -z "$rtag" ] || [ "$rtag" = "$ltag" ] ||
    fail "origin has $tag at $rtag, not the local $ltag: a pushed tag never moves (a changed release is a new patch version)"
  set --
  pushed=
  main_landed || { set -- "$lmain:refs/heads/main"; pushed=$upto; }
  [ "$rtag" = "$ltag" ] || { set -- "$@" "$tag"; pushed="${pushed:+$pushed and }$tag"; }
  OBOR_ALLOW_PUSH=1 git push origin "$@" || fail "git push origin $* failed"
  read_remote
  [ "$rtag" = "$ltag" ] && main_landed ||
    fail "after git push origin $*, origin has main '${rmain:-none}' and $tag '${rtag:-none}', not one containing $lmain and $ltag"
  say "pushed $pushed"
fi

# --- publish
command -v gh > /dev/null 2>&1 || fail "gh not found: install GitHub's CLI to publish the release"
# read_release: whether the GitHub release exists (has), is a draft (draft) and which of the four assets it lacks
# (missing, as platforms).
read_release() {
  has=0 draft= missing=
  assets=$(gh release view "$tag" --json assets --jq '.assets[].name' 2> /dev/null) || return 0
  has=1
  draft=$(gh release view "$tag" --json isDraft --jq .isDraft 2> /dev/null) || draft=unknown
  for pl in $platforms; do
    printf '%s\n' "$assets" | grep -qxF "obor-$v-$pl" || missing="${missing:+$missing }$pl"
  done
}
read_release
if [ "$has" = 1 ] && [ "$draft" = false ] && [ -z "$missing" ]; then
  say "the GitHub release for $tag is published with its four assets: publish skipped"
else
  if [ "$has" = 0 ]; then
    sh scripts/publish "$v" || fail "scripts/publish $v failed: re-run make ship"
    say "published $tag"
  elif [ -n "$missing" ]; then
    # shellcheck disable=SC2086 # platform names, no spaces
    sh scripts/publish "$v" --upload $missing || fail "uploading $missing failed: sh scripts/publish $v --upload $missing"
    say "uploaded the missing assets of $tag: $missing"
  fi
  read_release
  [ "$has" = 1 ] || fail "no GitHub release for $tag after scripts/publish: sh scripts/publish $v"
  [ -z "$missing" ] || fail "the GitHub release for $tag lacks $missing: sh scripts/publish $v --upload $missing"
  [ "$draft" = false ] || fail "the GitHub release for $tag is a draft: gh release edit $tag --draft=false"
fi

# --- install
# installed: the version the obor on PATH reports (empty when there is none).
installed() {
  command -v obor > /dev/null 2>&1 || return 0
  (cd / && obor version 2> /dev/null | awk 'NR == 1 { print $2 }') || true
}
if [ "$(installed)" = "$tag" ]; then
  say "the installed obor is $tag: install skipped"
else
  sh install.sh || fail "install.sh failed"
  got=$(installed)
  [ "$got" = "$tag" ] || fail "install.sh ran but obor version is '${got:-none}', not $tag: check PATH, then sh install.sh"
  say "installed the kit (install.sh): obor $tag"
fi

# --- tell the leads (T-715, T-903)
# The release notes (docs/releases/v<version>.md at the tag) to each project's lead but this kit's: `obor send
# <project> "obor v<version> is installed. <the notes on one line>"`, one per project of `obor projects`. A send that
# fails is reported and the rest go out; the failure ends ship after the reminder below, with the repair command.
release_notes=$(git show "$tag:docs/releases/$tag.md" 2> /dev/null) || fail "no docs/releases/$tag.md at $tag"
one=$(printf '%s\n' "$release_notes" | tr -s '[:space:]' ' ' | sed -e 's/^ //' -e 's/ $//')
[ -n "$one" ] || fail "docs/releases/$tag.md at $tag is empty"
text="obor $tag is installed. $one"
this=$(pwd -P)
projects=$(obor projects) || fail "obor projects failed: cannot tell the leads"
names=$(printf '%s\n' "$projects" | awk -v own="$this" '$2 != own { print $1 }')
told=0
for name in $names; do
  obor send "$name" "$text" || told=1
done
[ "$told" = 0 ] && say "told the leads of this machine's projects"

# Nothing to restart (T-719): serve and web watch the kit's binary and exec the new one themselves.
echo "serves and web follow the new binary within a minute"
[ "$told" = 0 ] ||
  fail "a lead was not told (above): obor send <project> \"obor $tag is installed. <the notes: git show $tag:docs/releases/$tag.md>\""
