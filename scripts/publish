#!/bin/sh
# publish <version>: upload the eight release binaries of v<version> (obor and the OpenCode kind, per platform, T-1046)
# to its GitHub release (`make publish`). The paths are a literal list (release-lib.sh's binaries and platforms), not
# GOOS_LIST/GOARCH_LIST and not a glob, and each is checked against the tag's own
# bin/checksums.txt before gh runs, so what is uploaded is what the tag's catalog names. The release carries a title
# "obor <version>" and the notes of docs/releases/v<version>.md at the tag (T-682), plus a Full Changelog line to the
# newest earlier GitHub release; a tag without the notes, or a failed release list, refuses before anything is created
# (T-683). POSIX sh.
#   publish <version> --check: only the checks (scripts/ship runs them before it pushes the tag);
#   publish <version> --upload <asset>…: the checks, then only those assets (<binary>-<version>-<os>-<arch>) to the
#   existing release (scripts/ship, for a release that lacks some of its assets).
set -eu

usage() { echo "usage: publish <version> [--check | --upload <asset>...]" >&2; exit 2; }
tmpdir=${TMPDIR:-/tmp}

# shellcheck source=scripts/release-lib.sh
. "$(dirname "$0")/release-lib.sh"

[ "$#" -ge 1 ] || usage
v=$1
shift
mode=create
case ${1:-} in
  "") ;;
  --check) [ "$#" = 1 ] || usage; mode=check ;;
  --upload)
    shift
    [ "$#" -ge 1 ] || usage
    assets=" $(release_assets "$v" | tr '\n' ' ')"
    for a in "$@"; do
      case $assets in *" $a "*) ;; *) usage ;; esac
    done
    mode=upload
    ;;
  *) usage ;;
esac
upload="$*"
tag="v$v"

fail() { echo "FAIL $*" >&2; exit 1; }

git rev-parse -q --verify "refs/tags/$tag" > /dev/null || fail "no tag $tag: commit the release, tag it, then publish"
tagver=$(git show "$tag:VERSION" 2> /dev/null | tr -d '[:space:]') || tagver=
[ "$tagver" = "$v" ] || fail "VERSION at $tag is '$tagver', want $v"
plugin=$(git show "$tag:.claude-plugin/plugin.json" 2> /dev/null |
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1) || plugin=
[ "$plugin" = "$v" ] || fail ".claude-plugin/plugin.json version at $tag is '$plugin', want $v"
# T-592: the release tag ships the marketplace name users install (main's obor-kit-dev names the dev checkout); T-645:
# and nothing else of main's marketplace.json changes (its plugin entry is still plugin.json's name).
require_tag_market
catalog=$(git show "$tag:bin/checksums.txt" 2> /dev/null) || fail "no bin/checksums.txt at $tag: commit the release's catalog before tagging"

files=
for a in $(release_assets "$v"); do
  f="dist/$a"
  [ -f "$f" ] || fail "missing $f: run make release first"
  want=$(printf '%s\n' "$catalog" | awk -v f="$f" '$2 == f { print $1; exit }')
  [ -n "$want" ] || fail "no line for $f in bin/checksums.txt at $tag"
  got=$(shasum -a 256 "$f" | awk '{ print $1 }')
  [ "$got" = "$want" ] || fail "$f sha256 $got differs from the $tag catalog's $want: rebuild at $tag (a pushed tag never moves: a changed release is a new version)"
  files="$files $f"
done

# Upload mode is unchanged: it adds assets to an existing release, whose notes are publish's create-mode business.
if [ "$mode" = upload ]; then
  set --
  for a in $upload; do set -- "$@" "dist/$a"; done
  exec gh release upload "$tag" "$@"
fi

# notes: the release notes at the tag (docs/releases/v<version>.md), the file the lead writes with the UPGRADE guide.
# They are read from the tag, not the working tree, so what is published is what was tagged; a tag without them is
# refused (the same check scripts/release runs for an existing tag, release-lib.sh).
notes=$(tag_notes)
problem=$(tag_notes_problem "$notes")
[ -z "$problem" ] || fail "$problem"

# newest_release: the newest GitHub release tag below this one (empty when there is none). It reads the releases, not the
# tags: a tag that was never released (v0.17.3, v0.17.4) is no baseline for the changelog link. A failed list is an
# error, not an empty one (T-683): publishing without the line could not be repaired by a re-run.
newest_release() {
  releases=$(gh release list --limit 100 --json tagName --jq '.[].tagName' 2> /dev/null) || return 1
  best=
  for rtag in $releases; do
    version_lt "${rtag#v}" "$v" || continue
    if [ -z "$best" ] || version_lt "${best#v}" "${rtag#v}"; then best=$rtag; fi
  done
  printf '%s\n' "$best"
}

if [ "$mode" = check ]; then exit 0; fi

# The notes file gh gets: the tag's notes, then the Full Changelog line to the newest earlier release (when there is
# one; the line is not in the file, publish adds it).
prev=$(newest_release) || fail "gh release list failed: cannot pick the Full Changelog baseline (no release was created; re-run publish)"
notesfile=$(mktemp "$tmpdir/obor-notes.XXXXXX")
trap 'rm -f "$notesfile"' EXIT
if [ -n "$prev" ]; then
  slug=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2> /dev/null) || slug=
  [ -n "$slug" ] || fail "gh repo view gave no owner/name: cannot name the Full Changelog link"
  printf '%s\n\n**Full Changelog**: https://github.com/%s/compare/%s...%s\n' "$notes" "$slug" "$prev" "$tag" > "$notesfile"
else
  printf '%s\n' "$notes" > "$notesfile"
fi
# shellcheck disable=SC2086 # the release's literal paths, no spaces
gh release create "$tag" --verify-tag --title "obor $v" --notes-file "$notesfile" $files
