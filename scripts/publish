#!/bin/sh
# publish <version>: upload the four release binaries of v<version> to its GitHub release (`make publish`). The four
# paths are a literal list, not GOOS_LIST/GOARCH_LIST and not a glob, and each is checked against the tag's own
# bin/checksums.txt before gh runs, so what is uploaded is what the tag's catalog names. POSIX sh.
#   publish <version> --check: only the checks (scripts/ship runs them before it pushes the tag);
#   publish <version> --upload <os-arch>…: the checks, then only those platforms' files to the existing release
#   (scripts/ship, for a release that lacks some of its four assets).
set -eu

usage() { echo "usage: publish <version> [--check | --upload <os-arch>...]" >&2; exit 2; }
platforms="darwin-arm64 darwin-amd64 linux-arm64 linux-amd64"

[ "$#" -ge 1 ] || usage
v=$1
shift
mode=create
case ${1:-} in
  "") ;;
  --check) [ "$#" = 1 ] || usage; mode=check ;;
  --upload)
    shift
    [ "$#" -ge 1 ] || usage
    for pl in "$@"; do
      case " $platforms " in *" $pl "*) ;; *) usage ;; esac
    done
    mode=upload
    ;;
  *) usage ;;
esac
upload="$*"
tag="v$v"

fail() { echo "FAIL $*" >&2; exit 1; }

git rev-parse -q --verify "refs/tags/$tag" > /dev/null || fail "no tag $tag: commit the release, tag it, then publish"
tagver=$(git show "$tag:VERSION" 2> /dev/null | tr -d '[:space:]') || tagver=
[ "$tagver" = "$v" ] || fail "VERSION at $tag is '$tagver', want $v"
plugin=$(git show "$tag:.claude-plugin/plugin.json" 2> /dev/null |
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1) || plugin=
[ "$plugin" = "$v" ] || fail ".claude-plugin/plugin.json version at $tag is '$plugin', want $v"
# T-592: the release tag ships the marketplace name users install (main's obor-kit-dev names the dev checkout).
market=$(git show "$tag:.claude-plugin/marketplace.json" 2> /dev/null | tr -d '\n' |
  sed -n 's/^[^"]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p') || market=
[ "$market" = obor-kit ] || fail ".claude-plugin/marketplace.json name at $tag is '$market', want obor-kit"
catalog=$(git show "$tag:bin/checksums.txt" 2> /dev/null) || fail "no bin/checksums.txt at $tag: commit the release's catalog before tagging"

files=
for platform in $platforms; do
  f="dist/obor-$v-$platform"
  [ -f "$f" ] || fail "missing $f: run make release first"
  want=$(printf '%s\n' "$catalog" | awk -v f="$f" '$2 == f { print $1; exit }')
  [ -n "$want" ] || fail "no line for $f in bin/checksums.txt at $tag"
  got=$(shasum -a 256 "$f" | awk '{ print $1 }')
  [ "$got" = "$want" ] || fail "$f sha256 $got differs from the $tag catalog's $want: rebuild at $tag (a pushed tag never moves: a changed release is a new version)"
  files="$files $f"
done

case $mode in
  check) exit 0 ;;
  upload)
    set --
    for platform in $upload; do set -- "$@" "dist/obor-$v-$platform"; done
    exec gh release upload "$tag" "$@"
    ;;
esac
# shellcheck disable=SC2086 # the four literal paths, no spaces
exec gh release create "$tag" --verify-tag $files
