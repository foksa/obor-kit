{
  "version": 1,
  "name": "myproject",
  "prefix": "mp",
  "lanes_dir": "../myproject-wt",
  "branches": { "main": "main", "task": "task/{id}" },
  "task_id_pattern": "T-[0-9]+[a-z]?",
  "paths": {
    "reviews": "docs/reviews"
  },
  "done_file_sections": ["Summary", "Self-check", "Skipped", "Open questions"],
  "commands": {
    "lane_setup": "bun install --frozen-lockfile",
    "lane_ready": "test -d node_modules",
    "check": { "cmd": "bun run check", "timeout": 900 },
    "baseline": { "cmd": "bun run baseline diff \"$OBOR_BASELINE\"", "dir": "../myproject-baseline/main", "timeout": 600 },
    "gate": { "cmd": "bun run gate", "timeout": 900, "paths": ["src/slow/**"] },
    "check_fast": "bun run check:fast",
    "e2e": "bun run e2e"
  },
  "lane_links": ["fixtures"],
  "protected_files": ["src/types.ts"],
  "lanes": 3,
  "difficulty": { "hard": ["opus:high"], "medium": ["sonnet:medium", "deepseek"], "simple": ["deepseek", "haiku"] },
  "roles": { "lead": "opus:high", "integrator": "opus", "reviewer": "sol:high" },
  "kinds": {
    "opencode": {
      "prompt_extra": "You run in opencode, not sandboxed; obor's opencode plugin guards your tools (git writes and files outside your lane are denied): no git commands, no installs, stay in this directory. Checks: the focused tests of the files you touched (never the whole suite). Quote summary lines and failures only."
    },
    "codex": { "prompt_extra": "Network is unavailable; deps are installed." }
  },
  "setup": { "confirmed": false },
  "merge": {
    "scratch_dir": null,
    "trailer": "Co-Authored-By: Claude <noreply@anthropic.com>",
    "summary_regex": "[0-9]+ pass|[0-9]+ fail",
    "fail_grep": "error|FAIL|Expected|Received"
  }
}
