{
  "version": 2,
  "project": {
    "name": "myproject",
    "agent_prefix": "mp",
    "task_id_pattern": "T-[0-9]+[a-z]?"
  },
  "lanes": {
    "count": 3,
    "dir": "../myproject-wt",
    "task_branch": "task/{id}",
    "links": ["fixtures"],
    "setup": "bun install --frozen-lockfile",
    "ready": "test -d node_modules"
  },
  "agents": {
    "roles": { "lead": "opus:high", "integrator": "opus", "reviewer": "sol:high" },
    "kinds": { "opencode": { "plugin": "obor-kind-opencode" } },
    "confirmed": false
  },
  "rules": {
    "protected_files": ["src/types.ts"]
  },
  "merge": {
    "target_branch": "main",
    "check": { "cmd": "bun run check", "timeout": 900 }
  },
  "nightly": {
    "at": "02:00",
    "slow_check": "bun run check:slow"
  },
  "commands": {
    "lint": "bun run lint"
  },
  "checks": {
    "output": {
      "summary": "[0-9]+ pass|[0-9]+ fail",
      "failure": "error|FAIL|Expected|Received"
    }
  },
  "reviews": {
    "dir": "docs/reviews"
  }
}
