#!/bin/bash
# bin/herd → bin/obor for old plugin copies, herdr's resolved path and old core.hooksPath. # until v0.17 (P7-0a fallback)
# A `herd` on PATH may be a symlink to this file: follow it first (as bin/obor does), or bin/obor is looked up next to the link.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
exec "$(dirname "$self")/obor" "$@"
