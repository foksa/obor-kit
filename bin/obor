#!/bin/bash
# obor <subcommand> [args…] — the kit's one bash file: finds the obor Go binary (the dev build dist/obor, else the
# pinned release in ~/.obor/bin, fetched and checksum-verified on first use with the kind binaries beside it) and execs
# it with the subcommand. Hooks (`obor hook <name>`, hooks/hooks.json) and a kind's hook transport (`obor kind <name>
# hook`) never fetch: without a usable binary the no-binary rule below applies.
set -euo pipefail

# Plugin root = parent of this file's directory (following symlinks to this file).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
OBOR_PLUGIN_ROOT=$(cd "$(dirname "$self")/.." && pwd -P)
export OBOR_PLUGIN_ROOT

# main_checkout [<dir>]: the main checkout of the repository at <dir> (default: cwd); fails outside a repository.
main_checkout() {
  local dir=${1:-.} common
  common=$(git -C "$dir" rev-parse --git-common-dir 2> /dev/null) || return 1
  common=$(cd "$dir" && cd "$common" 2> /dev/null && pwd -P) || return 1
  dirname "$common"
}

is_obor_checkout() {
  [ -f "$1/bin/obor" ] && [ -f "$1/.claude-plugin/plugin.json" ] &&
    [ "$(jq -r '.name // empty' "$1/.claude-plugin/plugin.json" 2> /dev/null)" = obor ]
}

# Self-hosting: inside an obor checkout (main or a lane worktree) `obor` runs the MAIN checkout's shim and binary,
# never a lane's own build (lane builds go stale after merges). To run a lane's own code:
# OBOR_NO_SELF_HOST=1 ./bin/obor …. Kit-owned callers (mods, hooks) pin OBOR_NO_SELF_HOST=1; self-hosting is for
# commands typed in a checkout.
self_host() {
  local root
  [ -z "${OBOR_SELF_HOSTED:-}" ] && [ -z "${OBOR_NO_SELF_HOST:-}" ] || return 0
  root=$(main_checkout) || return 0
  is_obor_checkout "$root" || return 0
  [ "$root" != "$OBOR_PLUGIN_ROOT" ] || return 0
  OBOR_SELF_HOSTED=1 exec "$BASH" "$root/bin/obor" "$@"
}

# usage: the shim's own lines; the commands are the binary's (`obor help`).
usage() {
  echo "usage: obor <subcommand> [args…]"
  echo "plugin root: $OBOR_PLUGIN_ROOT"
  echo "every command: obor help"
}

fail() { echo "FAIL $*" >&2; exit 1; }

# platform: sets os, arch, ver (the kit's VERSION), source and asset.
platform() {
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  case "$os" in darwin|linux) ;; *) return 1 ;; esac
  arch=$(uname -m)
  case "$arch" in x86_64|amd64) arch=amd64 ;; arm64|aarch64) arch=arm64 ;; *) return 1 ;; esac
  ver=$(cat "$OBOR_PLUGIN_ROOT/VERSION")
  source="kit default"
  asset="obor-$ver-$os-$arch"
}

# run <binary> <source> <args…>: exec the binary.
run() {
  local binary=$1 src=$2
  shift 2
  OBOR_VERSION_SOURCE="$src" exec "$binary" "$@"
}

# kind_assets: the kind binaries the catalog lists for this version and platform (obor-kind-<name>-<ver>-<os>-<arch>:
# obor runs them from beside its own binary), one per line.
kind_assets() {
  [ -f "$OBOR_PLUGIN_ROOT/bin/checksums.txt" ] || return 0
  awk -v tail="-$ver-$os-$arch" '{ n = $2; sub(/^dist\//, "", n) }
    index(n, "obor-kind-") == 1 && length(n) > length(tail) && substr(n, length(n) - length(tail) + 1) == tail { print n }' \
    "$OBOR_PLUGIN_ROOT/bin/checksums.txt"
}

# fetched: the release binary and each kind binary of this platform are in ~/.obor/bin.
fetched() {
  local kind
  [ -x "$binary" ] || return 1
  for kind in $(kind_assets); do [ -x "$(dirname "$binary")/$kind" ] || return 1; done
}

# fetch: the release binary for this platform, then each kind binary the catalog lists beside it, into ~/.obor/bin
# (curl, then each one's line in bin/checksums.txt must match). One already there is kept.
fetch() {
  local root=$OBOR_PLUGIN_ROOT url kind
  # OBOR_NO_FETCH=1 (git hooks: no network) turns a missing binary into a failure.
  [ -z "${OBOR_NO_FETCH:-}" ] || fail "no obor binary: make -C $root build"
  [ -f "$root/bin/release-url" ] || fail "missing release URL"
  [ -f "$root/bin/checksums.txt" ] || fail "missing checksums"
  command -v curl > /dev/null 2>&1 || fail "curl not found: install it or put the binary at $binary"
  url=$(sed -e "s/%VERSION%/$ver/g" -e "s/%OS%/$os/g" -e "s/%ARCH%/$arch/g" "$root/bin/release-url")
  mkdir -p "$(dirname "$binary")" || fail "cannot create binary directory"
  [ -x "$binary" ] || fetch_one "$asset" "$url" "$binary"
  # a kind's asset sits in the same release directory as obor's
  for kind in $(kind_assets); do
    [ -x "$(dirname "$binary")/$kind" ] || fetch_one "$kind" "${url%/*}/$kind" "$(dirname "$binary")/$kind"
  done
  prune_old
}

# fetch_one <asset> <url> <path>: the asset from url to path, once its checksum line matches.
fetch_one() {
  local name=$1 from=$2 to=$3 expected actual tmp
  tmp="$to.tmp.$$"
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  curl -fsSL "$from" -o "$tmp" || fail "cannot fetch $name from $from"
  expected=$(awk -v name="$name" '$2 == name || $2 == "dist/" name { print $1; exit }' "$OBOR_PLUGIN_ROOT/bin/checksums.txt")
  [ -n "$expected" ] || fail "no checksum for $name"
  if command -v shasum > /dev/null 2>&1; then actual=$(shasum -a 256 "$tmp" | awk '{print $1}')
  else actual=$(sha256sum "$tmp" | awk '{print $1}'); fi
  [ "$actual" = "$expected" ] || fail "checksum mismatch for $name"
  chmod 755 "$tmp"
  mv "$tmp" "$to"
  trap - EXIT HUP INT TERM
}

# release_platforms: the <os>-<arch> names make release builds (scripts/release-lib.sh's platforms): a ~/.obor/bin may
# hold the binaries of any of them.
release_platforms="darwin-arm64 darwin-amd64 linux-arm64 linux-amd64"

# versions_in <dir>: the versions of the release binaries in dir, the most recently fetched first (a fetched file's
# mtime is its fetch time), one per line.
versions_in() {
  local dir=$1 f name pl v
  ls -t "$dir"/obor-*-* 2> /dev/null | while IFS= read -r f; do
    [ -f "$f" ] || continue
    name=${f##*/}
    case "$name" in obor-kind-*) continue ;; esac
    for pl in $release_platforms; do
      case "$name" in
        "obor-"*"-$pl") v=${name#obor-}; printf '%s\n' "${v%-$pl}"; break ;;
      esac
    done
  done
}

# binary_version <name> <versions…>: the version of a release or kind binary file name (obor-<v>-<os>-<arch>,
# obor-kind-<kind>-<v>-<os>-<arch>) when it is one of <versions>; empty for any other name, so nothing else is removed.
binary_version() {
  local name=$1 pl v
  shift
  for pl in $release_platforms; do
    for v in "$@"; do
      case "$name" in
        "obor-$v-$pl"|obor-kind-*-"$v-$pl") printf '%s\n' "$v"; return 0 ;;
      esac
    done
  done
  return 0
}

# prune_old: after a fetch, remove the release and kind binaries of every version but the kit's and the one fetched
# before it (the most recent other version's files: the previous kit, kept for a rollback). Best effort: a
# failed remove never fails the command, and nothing that is not an obor release or kind binary is touched.
prune_old() {
  local dir prev f name v versions
  dir=$(dirname "$binary")
  versions=$(versions_in "$dir")
  prev=$(printf '%s\n' "$versions" | awk -v cur="$ver" '$0 != cur { print; exit }')
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    name=${f##*/}
    v=$(binary_version "$name" $versions)
    [ -n "$v" ] || continue
    case " $ver $prev " in *" $v "*) continue ;; esac
    rm -f "$f" 2> /dev/null || :
  done
}

# has_cmd <binary> [<args>…]: `<binary> has <args…>` exits 0 within OBOR_HOOK_TIMEOUT seconds (default 2; tests set 1;
# a stale or hanging binary must not hang a hook). On expiry the watchdog kills it. No job control (where setpgid is
# refused, `set -m` writes to stderr and the group kill misses): a simple background command is the binary's own pid.
# The watchdog sleeps in the background and waits, so a TERM ends it at once, its sleep with it.
has_cmd() {
  local binary=$1 pid watchdog rc=0 timeout=${OBOR_HOOK_TIMEOUT:-2}
  shift
  "$binary" has "$@" < /dev/null > /dev/null 2>&1 &
  pid=$!
  (
    s=
    trap 'kill "$s"; exit 0' TERM
    sleep "$timeout" &
    s=$!
    wait "$s"
    kill -KILL "$pid"
  ) > /dev/null 2>&1 &
  watchdog=$!
  wait "$pid" 2> /dev/null || rc=$?
  kill -TERM "$watchdog" 2> /dev/null || :
  wait "$watchdog" 2> /dev/null || :
  return "$rc"
}

# hint <why>: the repair line a hook prints when it has no answer: why, and the command that fixes it.
hint() { echo "obor: $1 — run: make -C $OBOR_PLUGIN_ROOT build"; }

# run_hook <binary> <source> <hook args…>: `hook <hook args>` on binary as a child, its answer the hook's: exit 0
# (allow) and 2 (a denial) pass through; any other end (another exit code, a kill) is no answer, and a hook with no
# answer denies pre-tool-use (exit 2) and allows the others, the hint on stderr.
run_hook() {
  local binary=$1 src=$2 err rc=0
  shift 2
  err="${TMPDIR:-/tmp}/obor-hook.$$"
  # The group's stderr is dropped: bash reports a child killed by a signal there ("… Killed: 9 …"), and the answer
  # already names the exit.
  { OBOR_VERSION_SOURCE="$src" "$binary" hook "$@" 2> "$err"; } 2> /dev/null || rc=$?
  if [ -s "$err" ]; then cat "$err" >&2 || :; fi
  rm -f "$err" || :
  case "$rc" in 0 | 2) exit "$rc" ;; esac
  hint "the binary at $binary ended hook $* with exit $rc" >&2
  [ "${1:-}" != pre-tool-use ] || exit 2
  exit 0
}

# in_project <event json>: the event's cwd is in an obor project (.obor/config.json in its main checkout) that is not
# stopped (obor stop: .obor/state/stopped).
in_project() {
  local cwd root
  cwd=$(jq -r '.cwd // empty' <<< "$1" 2> /dev/null) || return 1
  [ -n "$cwd" ] && [ -d "$cwd" ] || return 1
  root=$(main_checkout "$cwd") && [ -f "$root/.obor/config.json" ] && [ ! -f "$root/.obor/state/stopped" ]
}

# hook <name>: run `obor hook <name>` on the first usable binary, its answer the hook's (run_hook). None (missing,
# stale, hanging) in an obor project: pre-tool-use denies Bash / Edit / Write / MultiEdit / NotebookEdit with the
# repair hint, except the command that repairs it (exactly `make -C <kit> build`, or `make build` with cwd = the kit);
# the other hooks allow with the hint on stderr. Outside an obor project: allow, silent.
hook() {
  local name=${1:-} binary input tool cmd cwd
  # Kit-owned caller: every obor the binary runs uses this plugin root, not the cwd's checkout.
  export OBOR_NO_SELF_HOST=1
  if [ -x "$OBOR_PLUGIN_ROOT/dist/obor" ] && has_cmd "$OBOR_PLUGIN_ROOT/dist/obor" hook "$name"; then
    run_hook "$OBOR_PLUGIN_ROOT/dist/obor" "dev build" "$@"
  fi
  if platform; then
    binary="${HOME:-}/.obor/bin/$asset"
    if [ -x "$binary" ] && has_cmd "$binary" hook "$name"; then run_hook "$binary" "$source" "$@"; fi
  fi
  input=$(cat) || exit 0
  in_project "$input" || exit 0
  if [ "$name" != pre-tool-use ]; then
    hint "no usable Go binary in $OBOR_PLUGIN_ROOT" >&2
    exit 0
  fi
  tool=$(jq -r '.tool_name // ""' <<< "$input" 2> /dev/null) || tool=
  case "$tool" in
    Bash)
      cmd=$(jq -r '.tool_input.command // ""' <<< "$input" 2> /dev/null) || cmd=
      cmd=${cmd#"${cmd%%[![:space:]]*}"}
      cmd=${cmd%"${cmd##*[![:space:]]}"}
      [ "$cmd" = "make -C $OBOR_PLUGIN_ROOT build" ] && exit 0
      if [ "$cmd" = "make build" ]; then
        cwd=$(jq -r '.cwd // ""' <<< "$input" 2> /dev/null) || cwd=
        [ "$(cd "$cwd" 2> /dev/null && pwd -P)" = "$OBOR_PLUGIN_ROOT" ] && exit 0
      fi
      ;;
    Edit|Write|MultiEdit|NotebookEdit) ;;
    *) exit 0 ;;
  esac
  hint "no usable Go binary in $OBOR_PLUGIN_ROOT" >&2
  exit 2
}

# json_escape <text>: text as a JSON string's body, its backslashes and quotes escaped, so a kit path with either one
# still makes valid JSON.
json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

# kind_event <event json>: agy's hookEventName from its hook event, read as text (a kind's hook answers on a machine
# with no usable obor, so it counts on no JSON tool): empty when the event names none.
kind_event() {
  printf '%s' "$1" | sed -n 's/.*"hookEventName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

# running_project [<dir>]: dir (default: cwd) is in an obor project that is running: a .obor/config.json at it or
# above, and no .obor/state/stopped at that root. A linked worktree answers as its main checkout (obor stop writes
# the marker there, and the config may be only there; the kind's Go transport resolves it the same way); a git call
# that fails (no repo, odd layout) decides from dir as it stands.
running_project() {
  local dir root
  dir=$(cd "${1:-.}" 2> /dev/null && pwd -P) || return 1
  root=$(main_checkout "$dir") || root=
  [ -z "$root" ] || dir=$root
  while :; do
    if [ -f "$dir/.obor/config.json" ]; then
      [ ! -f "$dir/.obor/state/stopped" ] || return 1
      return 0
    fi
    [ "$dir" != / ] || return 1
    dir=$(dirname "$dir")
  done
}

# kind_hook <name> hook [args…]: a kind's hook transport (`obor kind <name> hook`, agy's .agents/hooks.json) follows
# the hook rules: it never fetches, the binary it runs must have `kind` (it runs the kind in process, no kind binary
# beside it), and with none it answers by event: an event named PreToolUse, or any event that carries a tool call (the
# raw text `"toolCall"`, since the shim counts on no JSON tool), is a PreToolUse whatever else the event says. In a
# running obor project it denies with the repair hint (agy shows the reason and blocks the tool), anywhere else it
# asks (agy's own check); every other event answers nothing (agy ignores those answers, and a deny or `{}` there only
# costs a cli.log line).
kind_hook() {
  local binary input
  export OBOR_NO_SELF_HOST=1
  binary=$OBOR_PLUGIN_ROOT/dist/obor
  if [ -x "$binary" ] && has_cmd "$binary" kind; then
    run "$binary" "dev build" kind "$@"
  fi
  if platform; then
    binary="${HOME:-}/.obor/bin/$asset"
    if [ -x "$binary" ] && has_cmd "$binary" kind; then run "$binary" "$source" kind "$@"; fi
  fi
  input=$(cat) || exit 0
  case "$input" in
    *'"toolCall"'*) ;;
    *) [ "$(kind_event "$input")" = PreToolUse ] || exit 0 ;;
  esac
  if running_project; then
    printf '{"decision":"deny","reason":"%s"}\n' "$(json_escape "$(hint "no usable Go binary in $OBOR_PLUGIN_ROOT")")"
  else
    printf '{"decision":"ask"}\n'
  fi
  exit 0
}

self_host "$@"

sub=${1:-}
case "$sub" in
  help|-h|--help)
    # where the kit is, then the binary's command list
    echo "plugin root: $OBOR_PLUGIN_ROOT"
    sub=help
    ;;
  ''|*[!a-z0-9-]*|-*)
    usage >&2
    exit 2
    ;;
esac
shift
[ "$sub" != hook ] || hook "$@"
# `obor kind <name> hook`: a kind's hook transport, so the hook rules (never a fetch).
[ "$sub" != kind ] || [ "${2:-}" != hook ] || kind_hook "$@"
# A stale dev build (without this command) says so: `make build` refreshes it.
[ ! -x "$OBOR_PLUGIN_ROOT/dist/obor" ] || run "$OBOR_PLUGIN_ROOT/dist/obor" "dev build" "$sub" "$@"
platform || fail "unsupported platform: $(uname -s) $(uname -m)"
binary="${HOME:-}/.obor/bin/$asset"
fetched || fetch
run "$binary" "$source" "$sub" "$@"
